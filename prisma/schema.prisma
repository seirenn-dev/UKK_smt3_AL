generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  kodeUser  String?  @unique @map("kode_user")
  fullname  String
  email     String   @unique
  password  String
  role      String   @default("staff")
  token     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model tbl_facility {
  kode_facility          String                   @id @db.VarChar(100)
  nama_facility          String                   @db.VarChar(100)
  create_at              DateTime                 @default(now()) @db.Timestamp(0)
  update_at              DateTime                 @default(now()) @db.Timestamp(0)
  tbl_type_unit_facility tbl_type_unit_facility[]

  @@index([kode_facility], map: "kode_facility")
}

model tbl_type_unit_facility {
  id_unit_type  Int           @id
  kode_facility String        @db.VarChar(10)
  tlb_unit_type tlb_unit_type @relation(fields: [id_unit_type], references: [id_unit_type], onUpdate: Restrict, map: "tbl_type_unit_facility_ibfk_1")
  tbl_facility  tbl_facility  @relation(fields: [kode_facility], references: [kode_facility], onUpdate: Restrict, map: "tbl_type_unit_facility_ibfk_2")

  @@index([kode_facility], map: "kode_facility")
}

model tlb_unit_type {
  id_unit_type           Int                     @id @default(autoincrement())
  nama_type_unit         String                  @db.VarChar(100)
  branch_id              Int
  create_at              DateTime                @default(now()) @db.Timestamp(0)
  update_at              DateTime                @default(now()) @db.Timestamp(0)
  tbl_type_unit_facility tbl_type_unit_facility?
}
